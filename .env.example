# Browser (inlined at build time)
VITE_APP_NAME=
# Leave empty: defaults to /__local-api in dev (RiverX routes /api/* to itself), /api in production.
VITE_API_BASE_URL=
# Injected by RiverX; leave empty locally and on your own Vercel project.
VITE_RIVERX_DB_URL=
VITE_RIVERX_DB_KEY=

# Server only: never prefix these with VITE_
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Team invite code for agent signup after the first admin. Unset = agent signup closed.
AGENT_SIGNUP_CODE=
# Public origin for password reset links, e.g. https://support.example.com
APP_URL=
